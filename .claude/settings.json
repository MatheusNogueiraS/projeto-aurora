{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm tokens)",
      "Bash(pnpm tokens:check)",
      "Bash(pnpm build)",
      "Bash(pnpm build-storybook)",
      "Bash(pnpm exec tsc -b --noEmit)",
      "Bash(node .claude/skills/aurora-componente/scripts/manifest.mjs *)",
      "Bash(node .claude/skills/aurora-componente/scripts/manifest.mjs)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
