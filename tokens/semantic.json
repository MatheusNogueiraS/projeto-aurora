{
  "$description": "Semânticos: dão significado aos átomos. Sempre apontam para outro token ({grupo.nome}), nunca para um valor literal. São os únicos tokens que os componentes podem usar. Tema padrão (claro, Bmg); o escuro sobrescreve só o necessário em themes/dark.json.",

  "color": {
    "$type": "color",
    "background": {
      "1": { "$value": "{color.neutral.0}" },
      "2": { "$value": "{color.neutral.20}", "$description": "Superfície escura em tema claro (ex.: tooltip)." },
      "3": { "$value": "{color.neutral.90}" },
      "4": { "$value": "{color.neutral.95}", "$description": "Superfície sutil: hover, selecionado, skeleton." },
      "5": { "$value": "{color.neutral.100}", "$description": "Fundo da página." },
      "6": { "$value": "{color.neutral.100}", "$description": "Superfície elevada: card, popover, menus." },
      "overlay": { "$value": "{color.black-alpha.64}", "$description": "Véu atrás de modais." },
      "overlay-inverse": { "$value": "{color.white-alpha.15}" }
    },
    "text": {
      "1": { "$value": "{color.neutral.0}", "$description": "Texto principal." },
      "2": { "$value": "{color.neutral.20}" },
      "3": { "$value": "{color.neutral.40}", "$description": "Texto secundário." },
      "4": { "$value": "{color.neutral.50}" },
      "5": { "$value": "{color.neutral.100}" },
      "6": { "$value": "{color.neutral.0}" }
    },
    "details": {
      "1": { "$value": "{color.neutral.60}" },
      "2": { "$value": "{color.neutral.80}" },
      "3": { "$value": "{color.neutral.90}" },
      "4": { "$value": "{color.neutral.90}" }
    },
    "img": {
      "skin-1": { "$value": "{color.skin.40}" },
      "skin-2": { "$value": "{color.skin.30}" },
      "skin-3": { "$value": "{color.skin.60}" },
      "skin-4": { "$value": "{color.skin.80}" },
      "skin-5": { "$value": "{color.skin.95}" },
      "details-1": { "$value": "{color.neutral.60}" },
      "details-2": { "$value": "{color.neutral.80}" },
      "details-3": { "$value": "{color.neutral.90}" },
      "details-4": { "$value": "{color.neutral.100}" },
      "primary": { "$value": "{color.brand.2}" },
      "secondary": { "$value": "{color.brand.1}" },
      "big-details": { "$value": "{color.brand.3}" },
      "small-details": { "$value": "{color.brand.4}" }
    },
    "brand": {
      "$description": "Cores da marca. Não mudam entre temas.",
      "1": { "$value": "{color.orange.50}" },
      "2": { "$value": "{color.purple.20}" },
      "3": { "$value": "{color.yellow.90}" },
      "4": { "$value": "{color.aqua.90}" }
    },
    "brand-details": {
      "1": { "$value": "{color.brand.2}" },
      "2": { "$value": "{color.brand.3}" },
      "3": { "$value": "{color.brand.4}" }
    },
    "link": {
      "$description": "CTAs e links.",
      "1": { "$value": "{color.brand.1}", "$description": "Ação principal (fundo)." },
      "2": { "$value": "{color.orange.95}" },
      "3": { "$value": "{color.orange.40}", "$description": "Ação principal: hover." },
      "4": { "$value": "{color.brand.2}", "$description": "Ação secundária (texto e borda)." },
      "5": { "$value": "{color.purple.90}", "$description": "Ação secundária: fundo e hover." },
      "6": { "$value": "{color.purple.10}" },
      "7": { "$value": "{color.aqua.90}" },
      "8": { "$value": "{color.aqua.95}" },
      "9": { "$value": "{color.green.50}" },
      "10": { "$value": "{color.neutral.100}", "$description": "Texto sobre a ação principal." },
      "11": { "$value": "{color.neutral.90}" },
      "12": { "$value": "{color.neutral.20}" }
    },
    "alerts": {
      "1": { "$value": "{color.green.50}" },
      "2": { "$value": "{color.green.90}" },
      "3": { "$value": "{color.green.30}", "$description": "Texto do alert de sucesso. green.30 (não green.40) para atingir 4.5:1 sobre alerts.2." },
      "4": { "$value": "{color.yellow.90}" },
      "5": { "$value": "{color.yellow.95}" },
      "6": { "$value": "{color.yellow.40}" },
      "7": { "$value": "{color.red.50}", "$description": "Erro (forte)." },
      "8": { "$value": "{color.red.90}", "$description": "Erro (fundo)." },
      "9": { "$value": "{color.red.30}", "$description": "Erro (texto sobre o fundo)." }
    },
    "splash": { "$value": "{color.brand.1}" },
    "shadow": { "$value": "{color.black-alpha.10}", "$description": "Cor das sombras (elevation)." },

    "focus": { "$value": "{color.link.4}", "$description": "Papel: anel e borda de foco em todos os componentes." },
    "invalid": { "$value": "{color.alerts.7}", "$description": "Papel: borda e anel de campo inválido." },
    "divider": { "$value": "{color.details.3}", "$description": "Papel: borda padrão e separadores." },
    "field": { "$value": "{color.neutral.50}", "$description": "Papel: borda de campos (input, select, checkbox...). Aponta direto para neutral-50 para garantir contraste mínimo de 3:1 (WCAG 1.4.11) nos dois temas." },
    "disabled": { "$value": "{color.text.4}", "$description": "Papel: texto de elemento desabilitado." },
    "disabled-surface": { "$value": "{color.link.11}", "$description": "Papel: fundo de ação desabilitada." }
  },

  "padding": {
    "$type": "dimension",
    "$description": "Espaço DENTRO de um elemento: padding e a distância de um item posicionado até a borda do container (top, right, inset). A altura dos controles vem do padding somado ao conteúdo.",
    "none": { "$value": "{value.0}" },
    "xxs": { "$value": "{value.2}" },
    "xs": { "$value": "{value.4}" },
    "sm": { "$value": "{value.8}" },
    "md": { "$value": "{value.12}" },
    "lg": { "$value": "{value.16}" },
    "xl": { "$value": "{value.20}" },
    "xxl": { "$value": "{value.32}" }
  },

  "gap": {
    "$type": "dimension",
    "$description": "Espaço ENTRE elementos: gap, margem, space-between e deslocamentos (translate).",
    "none": { "$value": "{value.0}" },
    "xxs": { "$value": "{value.2}" },
    "xs": { "$value": "{value.4}" },
    "sm": { "$value": "{value.8}" },
    "md": { "$value": "{value.12}" },
    "lg": { "$value": "{value.16}" },
    "xl": { "$value": "{value.20}" },
    "xxl": { "$value": "{value.32}" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Arredondamento. Escala única: todo componente usa um destes passos, sem token próprio.",
    "none": { "$value": "{value.0}" },
    "xxs": { "$value": "{value.4}" },
    "xs": { "$value": "{value.6}" },
    "sm": { "$value": "{value.8}" },
    "md": { "$value": "{value.12}" },
    "lg": { "$value": "{value.16}" },
    "xl": { "$value": "{value.24}" },
    "pill": { "$value": "{value.800}" }
  },

  "underline-offset": {
    "$type": "dimension",
    "$value": "{value.4}",
    "$description": "Distância entre o texto e o sublinhado dos links."
  },

  "stroke": {
    "$type": "dimension",
    "$description": "Espessura de linhas.",
    "none": { "$value": "{value.0}" },
    "default": { "$value": "{value.1}" },
    "focus": { "$value": "{value.3}", "$description": "Anel de foco." }
  },

  "opacity": {
    "$type": "number",
    "$description": "Escala geral de transparência, do invisível (none) ao opaco (full). Serve no elemento (opacity-md) e na cor (bg-link-1/lg).",
    "none": { "$value": "{opacity.0}", "$description": "Invisível." },
    "xs": { "$value": "{opacity.20}", "$description": "Bem leve (ex.: anel de erro)." },
    "sm": { "$value": "{opacity.40}" },
    "md": { "$value": "{opacity.50}", "$description": "Metade (ex.: desabilitado, anel de foco, pulso do skeleton)." },
    "lg": { "$value": "{opacity.70}", "$description": "Ex.: hover em cor cheia." },
    "xl": { "$value": "{opacity.90}" },
    "full": { "$value": "{opacity.100}", "$description": "Opaco." }
  },

  "font": {
    "$type": "fontFamily",
    "$description": "Papéis de fonte. Trocar a fonte do produto = mudar só aqui.",
    "heading": { "$value": "{font-family.poppins}", "$description": "Títulos (heading e display)." },
    "text": { "$value": "{font-family.lato}", "$description": "Textos (body e overline). A Lato só tem os pesos regular (400) e bold (700)." }
  },

  "font-size": {
    "$type": "dimension",
    "$description": "Escala de tamanhos de letra, como no Nitro: heading para títulos, text para textos. Os estilos de texto usam esta escala.",
    "heading": {
      "xxs": { "$value": "{value.20}" },
      "xs": { "$value": "{value.24}" },
      "sm": { "$value": "{value.32}" },
      "md": { "$value": "{value.40}" },
      "lg": { "$value": "{value.48}" },
      "xl": { "$value": "{value.56}" },
      "xxl": { "$value": "{value.64}" },
      "3xl": { "$value": "{value.72}" },
      "4xl": { "$value": "{value.80}" }
    },
    "text": {
      "xs": { "$value": "{value.10}" },
      "sm": { "$value": "{value.12}" },
      "md": { "$value": "{value.14}" },
      "lg": { "$value": "{value.16}" },
      "xl": { "$value": "{value.18}" }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "Estilos de texto, como no Nitro: display, heading (H1 a H6), body (por tamanho e peso) e overline. Cada um vira a classe typo-<estilo>.",
    "display-1": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.4xl}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "display-2": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.3xl}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "display-3": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.xxl}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "heading-1": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.xl}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "heading-2": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.lg}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "heading-3": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.md}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "heading-4": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.sm}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "heading-5": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.xs}", "lineHeight": "{line-height.120}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "heading-6": { "$value": { "fontFamily": "{font.heading}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.heading.xxs}", "lineHeight": "{line-height.130}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-xl-regular": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.regular}", "fontSize": "{font-size.text.xl}", "lineHeight": "{line-height.140}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-xl-bold": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.text.xl}", "lineHeight": "{line-height.140}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-lg-regular": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.regular}", "fontSize": "{font-size.text.lg}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-lg-bold": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.text.lg}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-md-regular": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.regular}", "fontSize": "{font-size.text.md}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-md-bold": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.text.md}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-sm-regular": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.regular}", "fontSize": "{font-size.text.sm}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "body-sm-bold": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.text.sm}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.0}", "textCase": "{text-case.original}" } },
    "overline-regular": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.regular}", "fontSize": "{font-size.text.xs}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.100}", "textCase": "{text-case.upper}" } },
    "overline-bold": { "$value": { "fontFamily": "{font.text}", "fontWeight": "{font-weight.bold}", "fontSize": "{font-size.text.xs}", "lineHeight": "{line-height.150}", "letterSpacing": "{letter-spacing.100}", "textCase": "{text-case.upper}" } }
  },

  "elevation": {
    "$type": "shadow",
    "$description": "Sombras dos elementos que se destacam na tela.",
    "s": { "$value": { "color": "{color.shadow}", "offsetX": "{value.0}", "offsetY": "{value.1}", "blur": "{value.4}", "spread": "{value.0}" }, "$description": "Destaque leve (campos, controles)." },
    "m": { "$value": { "color": "{color.shadow}", "offsetX": "{value.0}", "offsetY": "{value.4}", "blur": "{value.8}", "spread": "{value.0}" }, "$description": "Sobreposições (popover, menus)." },
    "inverse": { "$value": { "color": "{color.shadow}", "offsetX": "{value.0}", "offsetY": "-{value.4}", "blur": "{value.8}", "spread": "{value.0}" }, "$description": "Elementos presos embaixo (sombra para cima)." }
  },

  "layer": {
    "$type": "number",
    "base": { "$value": "{layer.0}" },
    "raised": { "$value": "{layer.10}", "$description": "Acima do conteúdo vizinho." },
    "overlay": { "$value": "{layer.50}", "$description": "Sobreposições: popover, tooltip, menus." }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "{duration.100}", "$description": "Abrir/fechar sobreposições." },
      "normal": { "$value": "{duration.150}", "$description": "Hover, foco e tooltip." },
      "slow": { "$value": "{duration.200}", "$description": "Abrir/fechar accordion." },
      "spin": { "$value": "{duration.1000}", "$description": "Uma volta do ícone de carregando." },
      "pulse": { "$value": "{duration.2000}", "$description": "Um ciclo do skeleton." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "{easing.in-out}", "$description": "Hover e foco." },
      "overlay": { "$value": "{easing.ease}", "$description": "Abrir/fechar sobreposições." },
      "expand": { "$value": "{easing.ease-out}", "$description": "Abrir/fechar accordion." },
      "linear": { "$value": "{easing.linear}", "$description": "Animações contínuas (spin)." },
      "pulse": { "$value": "{easing.pulse}" }
    },
    "distance": {
      "$type": "dimension",
      "overlay": { "$value": "{value.8}", "$description": "Quanto a sobreposição desliza ao abrir." }
    },
    "scale": {
      "$type": "number",
      "overlay": { "$value": "{scale.95}", "$description": "Tamanho inicial da sobreposição ao abrir." }
    }
  },

  "rotate": {
    "$type": "string",
    "diagonal": { "$value": "{angle.45}", "$description": "Ex.: seta do tooltip." },
    "flip": { "$value": "{angle.180}", "$description": "Espelha ícones em idiomas escritos da direita para a esquerda." }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "{value.640}" },
    "md": { "$value": "{value.768}" },
    "lg": { "$value": "{value.1024}" }
  }
}
